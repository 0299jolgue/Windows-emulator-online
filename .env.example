WINDOWS_VERSION=11

# ISO do Windows. Faz download/obtem a ISO por meios oficiais e coloca-a aqui.
WINDOWS_ISO=data/Windows11.iso

# Disco persistente da VM.
WINDOWS_DISK=data/windows/windows.qcow2
WINDOWS_DISK_SIZE=100G

# Recursos da VM.
WINDOWS_CPU=4
WINDOWS_RAM=10G

# QEMU VNC fica só no host; noVNC é o serviço que a hospedagem deve publicar.
VNC_BIND=127.0.0.1
VNC_PORT=5900

NOVNC_BIND=0.0.0.0
NOVNC_PORT=80

# Opcional: localização dos ficheiros web do noVNC.
NOVNC_WEB=

# O launcher procura automaticamente, mas podes indicar caminhos exatos.
OVMF_CODE=
OVMF_VARS=

# Windows 11: tenta iniciar um TPM 2.0 virtual quando "swtpm" está instalado.
WINDOWS_TPM=Y

# Tenta instalar QEMU/OVMF/noVNC automaticamente quando o host permitir.
AUTO_INSTALL=Y
# Tenta instalar um QEMU pré-compilado dentro do próprio projeto, sem root.
AUTO_INSTALL_QEMU=Y
# Ajusta automaticamente a RAM da VM ao limite real do container, quando disponível.
AUTO_TUNE_RESOURCES=Y
