WINDOWS_VERSION=11

WINDOWS_LANGUAGE=Portuguese
WINDOWS_REGION=pt-PT
WINDOWS_KEYBOARD=pt-PT

# Aplicados durante a instalação inicial do Windows.
WINDOWS_USERNAME=WindowsUser
WINDOWS_PASSWORD=ChangeThisPassword123!
WINDOWS_KEY=
WINDOWS_AUTOLOGIN=Y

# Perfil prático para uma VM Windows remota.
WINDOWS_CPU=4
WINDOWS_RAM=8G
WINDOWS_DISK=100G

# N = sem proteção extra do web viewer do Dockur.
WINDOWS_PROTECT=N

WINDOWS_AUDIO=N

# Tamanho máximo de um ficheiro enviado, em bytes. 2 GiB por defeito.
MAX_FILE_SIZE=2147483648
